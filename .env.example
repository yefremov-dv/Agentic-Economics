# Ключ авторизации GigaChat (Authorization key из личного кабинета developers.sber.ru)
GIGACHAT_CREDENTIALS=
# Готовый токен доступа (живёт 30 минут) — если OAuth-эндпоинт на порту 9443 недоступен
# GIGACHAT_ACCESS_TOKEN=
# GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B / GIGACHAT_API_CORP — юрлица
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Проверка TLS-сертификатов. false — если не установлен корневой сертификат Минцифры
GIGACHAT_VERIFY_SSL_CERTS=true
